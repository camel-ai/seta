# Copy to .env in this folder and fill in. Values here override the script defaults.

# --- Cluster (required) ---
HEAD_IP=192.0.2.10                       # Ray head = the node you launch on (or set CLUSTER_CONFIG, see ../../cluster.example.yaml)
# CLUSTER_CONFIG=/path/to/cluster.yaml   # alternative to HEAD_IP: head.ip is read from it
# NCCL_SOCKET_IFNAME=bond0               # GPU interconnect interface, if it is not the default route
# GLOO_SOCKET_IFNAME=bond0               # same, for Gloo

# --- Model (required) ---
MODEL_ROOT=/root/models                  # where prepare_model.sh put Qwen3.8-27B and Qwen3.8-27B_torch_dist
# MODEL_DIR=/root/models/Qwen3.8-27B     # HF checkpoint (tokenizer, config, engine boot weights)
# INIT_LOAD=/root/models/Qwen3.8-27B_torch_dist   # torch_dist checkpoint the actor starts from (and KL reference)

# --- Data (required) ---
PROMPT_DATA=/path/to/train.jsonl         # prompt JSONL, see ../../data/README.md (build it from SETA-Env)
TASKS_DIR=/path/to/tasks                 # Harbor task directories referenced by PROMPT_DATA

# --- Sandboxes (required: one backend) ---
SANDBOX_BACKEND=daytona                  # daytona | modal | gke | docker
DAYTONA_API_KEY=                         # https://app.daytona.io -> API keys
# DAYTONA_API_URL=https://app.daytona.io/api
# MODAL_TOKEN_ID=                        # for SANDBOX_BACKEND=modal (or run `modal token new`)
# MODAL_TOKEN_SECRET=
# GKE, for SANDBOX_BACKEND=gke: your own cluster (README Step 4; ../../common/gke_cluster.sh reads these too)
# GKE_PROJECT_ID=my-project              # Google Cloud project
# GKE_REGION=us-central1                 # region of the cluster, the registry and Cloud Build
# GKE_CLUSTER_NAME=harbor-sandboxes      # cluster name
# GKE_TOOLS_IMAGE=                       # the line ../../common/gke_tools_image.sh prints (tmux etc. for the agent)
# GKE_NAMESPACE=default                  # namespace of the sandbox pods
# GKE_REGISTRY_NAME=harbor-sandboxes     # Artifact Registry Docker repository for task images (in GKE_REGION)
# GKE_KUBECONFIG=                        # default ~/.kube/gke_<project>_<region>_<cluster>, written on first use
# GKE_POD_PRIVILEGED=auto                # auto: privileged pods only for tasks that run their own Docker daemon; false: never
# GKE_MEMORY_LIMIT_MULTIPLIER=           # memory limit = N x request; default: no limit
# GKE_CLUSTER_DEFAULT_DENY_EGRESS=false  # true after `gke_cluster.sh apply-network-policies`: also run tasks that ask for no network
# GKE_CLOUD_BUILD_CONFIG=                # task image build config; default Harbor's examples/gke-grpo-rollout/cloudbuild-buildkit.yaml
# GKE_CLOUD_BUILD_LOGS_BUCKET=           # gs://bucket for build logs; default: Cloud Logging only
# GKE_CLOUD_BUILD_WORKER_POOL=           # projects/<project>/locations/<region>/workerPools/<pool>; default: Google's shared pool
# GKE_COMPOSE_PREBUILT_MANIFEST_PATH=    # prebuilt images for Compose tasks; needs the next two
# GKE_REGISTRY_TOKEN_IMPERSONATOR=       #   service account the head node impersonates to mint a registry token
# GKE_REGISTRY_TOKEN_SERVICE_ACCOUNT=    #   registry reader whose short-lived token the sandbox's Docker uses
# Cluster shape, used by ../../common/gke_cluster.sh create and scale:
# GKE_NODE_POOLS="sandboxes=n2-standard-16"   # <pool>=<machine type> ..., one pool per machine family
# GKE_ZONES=                             # e.g. us-central1-a,us-central1-b; default: three zones chosen by GKE
# GKE_DISK_SIZE_GB=250                   # sandbox node disk: task images and sandbox storage
# GKE_SYSTEM_MACHINE_TYPE=e2-standard-2  # one node per zone for kube-system
# GKE_NETWORK=default                    # existing VPC; GKE_SUBNETWORK defaults to the same name
# GKE_CREATE_NETWORK=0                   # 1: create a dedicated VPC and subnet
# GKE_PRIVATE_NODES=0                    # 1: nodes without public IPs, with Cloud NAT for sandbox internet
# GKE_AUTHORIZED_NETWORKS=               # CIDRs that may reach the control plane; include the head node's public IP

# --- Logging (optional) ---
# WANDB_API_KEY=                         # enables W&B; key from https://wandb.ai/authorize (passed to Miles as --wandb-key)
# WANDB_PROJECT=seta
# WANDB_ENTITY=                          # your W&B team; default: your user

# --- Hugging Face (prepare_model.sh; the model is public, a token only lifts rate limits) ---
# HF_TOKEN=

# --- Outputs ---
# RUNS_ROOT=/shared/runs                 # default ./runs under the launch directory; must be on storage every node sees
# RUN_NAME=                              # default qwen3-8-27b-terminus2-grpo-<UTC time>; reuse a name to resume

# --- Checkouts (defaults are the Docker image's) ---
# MILES_DIR=/root/miles
# MEGATRON_PATH=/root/Megatron-LM
# SGLANG_DIR=/sgl-workspace/sglang
# STRICT_PINS=1                          # fail instead of warn when a checkout is not at the tested commit
# HARBOR_HOME=~/.cache/seta/harbor       # where the pinned Harbor is installed
# AGENT_SERVER_PORT=11000                # Harbor agent server port on the head node

# --- Training (optional; defaults are the tested configuration) ---
# NUM_NODES=4                            # nodes in the Ray cluster
# ROLLOUT_NODES=2                        # nodes running SGLang engines; the rest train
# GPUS_PER_NODE=8
# PIPELINE_PARALLEL_SIZE=1               # actor PP (TP is 4)
# CONTEXT_PARALLEL_SIZE=4                # actor CP: each sample is split over this many GPUs
# MAX_SEQ_LEN=131072                     # tokens per training sample (prompt + all turns)
# MAX_RESPONSE_LEN=32768                 # tokens per model turn
# MAX_TOKENS_PER_GPU=32768               # default MAX_SEQ_LEN / CONTEXT_PARALLEL_SIZE
# NUM_ROLLOUT=3000                       # optimizer steps
# ROLLOUT_BATCH_SIZE=16                  # prompts per step
# N_SAMPLES_PER_PROMPT=8                 # trials per prompt (the GRPO group)
# GLOBAL_BATCH_SIZE=128                  # must equal ROLLOUT_BATCH_SIZE x N_SAMPLES_PER_PROMPT
# AGENT_MAX_CONCURRENT=128               # trials in flight
# MAX_WEIGHT_STALENESS=2                 # weight updates a trial may lag and still train
# DYNAMIC_SAMPLING_FILTER=check_no_infra_failure   # none | check_no_infra_failure | check_no_infra_failure_and_nonzero_std
# LR=1e-6
# SAVE_INTERVAL=30                       # steps between checkpoints
# EXTRA_ARGS=                            # extra Miles/Megatron flags, appended last
# HARBOR_AGENT_MAX_ITERATIONS=10000      # agent turn cap (effectively off)
# HARBOR_MAX_SEQ_LEN=131072              # agent context bound; default MAX_SEQ_LEN
# HARBOR_AGENT_TIMEOUT_SEC=28800         # agent-phase budget per trial; the trial is still tested
# HARBOR_AGENT_CALL_TIMEOUT_SEC=36000    # client deadline per trial; the sample is dropped
# HARBOR_TERMINUS_PARSER=xml
# HARBOR_INTERLEAVED_THINKING=true
# HARBOR_TERMINUS_ENABLE_SUMMARIZE=true
# SANDBOX_CPUS=1                         # GKE sandbox size; other backends use each task's own resources
# SANDBOX_MEMORY_MB=2048
# SANDBOX_STORAGE_MB=8192
# GKE_POD_READY_TIMEOUT_SEC=1200         # GKE pod readiness deadline (many concurrent cold starts)
# HARBOR_COMMIT=ab9eaefa3c8c24777e5dd5ff2f0c615694573393
