# Copy to .env in this folder and fill in:  cp env.example .env
# run_env_service.sh reads it (or the file named by ENV_FILE); values here override the
# script defaults. Keep .env out of version control: it holds your keys.

# --- Cluster (required) ---
HEAD_IP=192.0.2.10                        # Ray head node's IP; the Ray workers reach the env_service there
# CLUSTER_CONFIG=/path/to/cluster.yaml    # instead of HEAD_IP: a copy of ../../cluster.example.yaml
# NCCL_SOCKET_IFNAME=bond0                # interconnect interface, if not the default route
# GLOO_SOCKET_IFNAME=bond0

# --- Model (required) ---
MODEL_ROOT=/root/models                   # holds GLM-4.7-Flash and GLM-4.7-Flash_torch_dist (README Step 3)

# --- Data (required) ---
PROMPT_DATA=/shared/prompts/train.jsonl   # one row per task (README Step 5)
TASKS_DIR=/shared/dataset/seta-env-final  # the task directories PROMPT_DATA refers to

# --- Sandboxes: Daytona (required) ---
DAYTONA_API_KEY=                          # https://app.daytona.io -> API keys
# DAYTONA_API_URL=https://app.daytona.io/api

# --- env_service Python (README Step 4) ---
# ENV_SERVICE_PYTHON=/workspace/seta/.venv/bin/python   # default: <seta checkout>/.venv/bin/python

# --- Logging (optional) ---
# WANDB_API_KEY=                         # enables W&B; key from https://wandb.ai/authorize (passed to Miles as --wandb-key)
# WANDB_PROJECT=glm47-flash-grpo
# WANDB_ENTITY=                           # your W&B team; default: your user

# --- Outputs ---
# RUNS_ROOT=./runs                        # run folders go to RUNS_ROOT/RUN_NAME
# RUN_NAME=                               # default glm47-flash-grpo-<UTC time>; reuse a name to resume

# --- Versions ---
# MILES_DIR=/root/miles
# MEGATRON_PATH=/root/Megatron-LM
# STRICT_PINS=1                           # fail instead of warn when /root/miles is not at the tested commit

# --- Training (optional). Defaults: the tested configuration ---
# NUM_NODES=8
# ROLLOUT_NUM_NODES=7                     # nodes serving SGLang; the rest train
# GPUS_PER_NODE=8
# NUM_ROLLOUT=3000                        # optimizer steps
# ROLLOUT_BATCH_SIZE=16                   # prompt groups per step
# N_SAMPLES_PER_PROMPT=16                 # trajectories per prompt (the GRPO group)
# ROLLOUT_CONCURRENCY=30                  # prompt groups in flight
# MAX_WEIGHT_STALENESS=4
# GROUP_FILTER_MIN_REWARD_STD=1e-8
# GROUP_FILTER_MAX_ENV_FAILURES=1
# LR=1e-6
# SAVE_INTERVAL=50
# DUMP_DETAILS=0
# EXTRA_ARGS=                             # extra Miles flags, appended last

# --- env_service (optional) ---
# ENV_SERVICE_CONFIG=                     # default: env_service.yaml in this folder
# ENV_SERVICE_PORT=8002
# MAX_SLOTS=400                           # concurrent sandboxes; see the Daytona quota note in README
# STEP_TIMEOUT_SECONDS=5000
# STEP_USE_SUBPROCESS=1
# BUILD_CONCURRENCY=24
# INFLIGHT_LEAD=64
# HARBOR_DAYTONA_MAX_CREATES=24
# DAYTONA_DECLARATIVE=1
# DAYTONA_SNAPSHOT_EVICT_AGE_HOURS=3
# MODEL_TIMEOUT=900
