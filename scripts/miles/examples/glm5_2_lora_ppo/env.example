# Copy to .env in this folder and fill in. Values here override the script defaults.
# Read by run_harbor_terminus2.sh, prepare_model.sh and setup_megatron_bridge.sh.

# --- Cluster (required) ---
HEAD_IP=192.0.2.10                       # Ray head node IP; the launcher runs on this node (or set CLUSTER_CONFIG)
# CLUSTER_CONFIG=/path/to/cluster.yaml   # a copy of ../../cluster.example.yaml, instead of HEAD_IP
# NUM_NODES=4                            # nodes of 8 GPUs (must match the Ray cluster; this recipe runs on 4)
# NCCL_SOCKET_IFNAME=bond0               # interconnect interface, if not the default route
# GLOO_SOCKET_IFNAME=bond0

# --- Model and checkouts (paths must be the same on every node) ---
MODEL_ROOT=/root/models                  # prepare_model.sh puts GLM-5.2 and GLM-5.2-FP8 here
# MODEL_DIR=/root/models/GLM-5.2         # BF16 checkpoint: base of the actor and the critic
# FP8_MODEL_DIR=/root/models/GLM-5.2-FP8 # FP8 rollout checkpoint
MEGATRON_BRIDGE_DIR=/root/Megatron-Bridge-glm5_2   # setup_megatron_bridge.sh checks it out here
# OFFLOAD_DIR=/root/miles_train_offload  # fast node-local disk, ~1.2 TB free per node, not tmpfs
# MILES_DIR=/root/miles                  # Miles checkout at the pinned commit
# MEGATRON_PATH=/root/Megatron-LM
# SGLANG_DIR=/sgl-workspace/sglang

# --- Data (required) ---
PROMPT_DATA=/path/to/train.jsonl         # see ../../data/README.md (build from SETA-Env)
TASKS_DIR=/path/to/tasks                 # Harbor task directories referenced by PROMPT_DATA

# --- Sandboxes (required: one backend) ---
SANDBOX_BACKEND=daytona                  # daytona | modal | gke | docker
DAYTONA_API_KEY=                         # https://app.daytona.io -> API keys
# DAYTONA_API_URL=https://app.daytona.io/api
# MODAL_TOKEN_ID=                        # SANDBOX_BACKEND=modal (or run `modal token new`)
# MODAL_TOKEN_SECRET=
# GKE, for SANDBOX_BACKEND=gke: your own cluster (README Step 4; ../../common/gke_cluster.sh reads these too)
# GKE_PROJECT_ID=my-project              # Google Cloud project
# GKE_REGION=us-central1                 # region of the cluster, the registry and Cloud Build
# GKE_CLUSTER_NAME=harbor-sandboxes      # cluster name
# GKE_TOOLS_IMAGE=                       # the line ../../common/gke_tools_image.sh prints (tmux etc. for the agent)
# GKE_NAMESPACE=default                  # namespace of the sandbox pods
# GKE_REGISTRY_NAME=harbor-sandboxes     # Artifact Registry Docker repository for task images (in GKE_REGION)
# GKE_KUBECONFIG=                        # default ~/.kube/gke_<project>_<region>_<cluster>, written on first use
# GKE_POD_PRIVILEGED=auto                # auto: privileged pods only for tasks that run their own Docker daemon; false: never
# GKE_MEMORY_LIMIT_MULTIPLIER=           # memory limit = N x request; default: no limit
# GKE_CLUSTER_DEFAULT_DENY_EGRESS=false  # true after `gke_cluster.sh apply-network-policies`: also run tasks that ask for no network
# GKE_CLOUD_BUILD_CONFIG=                # task image build config; default Harbor's examples/gke-grpo-rollout/cloudbuild-buildkit.yaml
# GKE_CLOUD_BUILD_LOGS_BUCKET=           # gs://bucket for build logs; default: Cloud Logging only
# GKE_CLOUD_BUILD_WORKER_POOL=           # projects/<project>/locations/<region>/workerPools/<pool>; default: Google's shared pool
# GKE_COMPOSE_PREBUILT_MANIFEST_PATH=    # prebuilt images for Compose tasks; needs the next two
# GKE_REGISTRY_TOKEN_IMPERSONATOR=       #   service account the head node impersonates to mint a registry token
# GKE_REGISTRY_TOKEN_SERVICE_ACCOUNT=    #   registry reader whose short-lived token the sandbox's Docker uses
# Cluster shape, used by ../../common/gke_cluster.sh create and scale:
# GKE_NODE_POOLS="sandboxes=n2-standard-16"   # <pool>=<machine type> ..., one pool per machine family
# GKE_ZONES=                             # e.g. us-central1-a,us-central1-b; default: three zones chosen by GKE
# GKE_DISK_SIZE_GB=250                   # sandbox node disk: task images and sandbox storage
# GKE_SYSTEM_MACHINE_TYPE=e2-standard-2  # one node per zone for kube-system
# GKE_NETWORK=default                    # existing VPC; GKE_SUBNETWORK defaults to the same name
# GKE_CREATE_NETWORK=0                   # 1: create a dedicated VPC and subnet
# GKE_PRIVATE_NODES=0                    # 1: nodes without public IPs, with Cloud NAT for sandbox internet
# GKE_AUTHORIZED_NETWORKS=               # CIDRs that may reach the control plane; include the head node's public IP
# SANDBOX_CPUS=1                         # sandbox size for SANDBOX_BACKEND=gke (script defaults; `task` = task's own)
# SANDBOX_MEMORY_MB=2048
# SANDBOX_STORAGE_MB=8192
# GKE_POD_READY_TIMEOUT_SEC=1200         # SANDBOX_BACKEND=gke: pod start deadline (script default)

# --- Logging (optional) ---
# WANDB_API_KEY=                         # enables W&B; key from https://wandb.ai/authorize (passed to Miles as --wandb-key)
# WANDB_PROJECT=seta
# WANDB_ENTITY=                          # your W&B team; default: your user

# --- Hugging Face (prepare_model.sh; both repos are public) ---
# HF_TOKEN=

# --- Outputs ---
# RUNS_ROOT=./runs                       # run folders go to RUNS_ROOT/RUN_NAME (shared storage)
# RUN_NAME=                              # default: glm5_2-lora-ppo-terminus2-<UTC time>

# --- Harbor (optional) ---
# HARBOR_COMMIT=5af13d825dd8b4b8ae330133ce25ecb3019653ba
# HARBOR_HOME=~/.cache/seta/harbor       # Harbor checkout + venv per commit
# AGENT_SERVER_PORT=11000
# STRICT_PINS=0                          # 1: fail instead of warn when a checkout is not at the tested commit

# --- Training (optional; defaults are the configuration this recipe was run with) ---
# SMOKE=0                                # 1: 3 short steps (1 group x 8 trials, 10 turns) to check the stack
# NUM_ROLLOUT=200                        # rollout / optimizer steps
# ROLLOUT_BATCH_SIZE=16                  # prompt groups trained on per step
# N_SAMPLES_PER_PROMPT=2                 # trials per prompt
# OVER_SAMPLING_BATCH_SIZE=24            # prompt groups started per step
# GLOBAL_BATCH_SIZE=32                   # ROLLOUT_BATCH_SIZE x N_SAMPLES_PER_PROMPT
# ROLLOUT_TEMPERATURE=0.8
# LR=3e-5                                # actor learning rate
# CRITIC_LR=3e-5                         # critic learning rate
# NUM_CRITIC_ONLY_STEPS=1                # first steps train only the critic
# LORA_RANK=16                           # actor and critic adapters
# LORA_ALPHA=32
# SAVE_INTERVAL=10                       # checkpoint every N steps
# MAX_SEQ_LEN=49152                      # longest training sample
# MAX_TOKENS_PER_GPU=49152
# MAX_RESPONSE_LEN=16384                 # longest model response per turn
# SGLANG_CONTEXT_LENGTH=1048576
# SGLANG_MEM_FRACTION=0.80
# SGLANG_LORA_FASTPATH=0                 # 1: SGLang's experimental LoRA path
# SESSION_SERVERS=16
# SESSION_SERVER_PORT=30000
# SESSION_SERVER_STARTUP_TIMEOUT_SECS=600
# AGENT_MAX_CONCURRENT=48                # OVER_SAMPLING_BATCH_SIZE x N_SAMPLES_PER_PROMPT
# HARBOR_AGENT_MAX_ITERATIONS=75
# HARBOR_MAX_SEQ_LEN=49152               # agent context bound
# HARBOR_TERMINUS_PARSER=xml
# HARBOR_INTERLEAVED_THINKING=true
# HARBOR_TERMINUS_ENABLE_SUMMARIZE=true
# HARBOR_RESPONSE_LENGTH_POLICY=regenerate
# HARBOR_AGENT_TIMEOUT_SEC=5400          # agent budget per trial (trial still verified)
# HARBOR_AGENT_CALL_TIMEOUT_SEC=10800    # client deadline per trial (sample dropped)
# EXTRA_ARGS=                            # extra Miles arguments, appended as-is
